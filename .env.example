# Copy this file to .env at the repo root and fill in the value.
# .env is git-ignored and must never be committed or printed.
#
# One key covers the chat model and the embedding model, both on the gateway
# configured in backend/config/chat.toml and backend/config/embeddings.toml.
LLM_API_KEY=

# Signs the route token that binds a reasoning answer to its question and student.
# A random key is minted per process when this is absent, so the tokens of this
# process do not survive a restart and a student's consent stops matching the answer
# it was given for; set it to keep a token valid across restarts.
KSU_ROUTE_SECRET=
